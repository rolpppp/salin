# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-public-key

# Auth
JWT_SECRET=your-jwt-secret

# Email (Resend)
RESEND_API_KEY=your-resend-key
